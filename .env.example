# Host makineden veritabanina baglanan komutlar icin:
# Docker kullanirken PostgreSQL host portu POSTGRES_PORT ile acilir.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/knowledgeos

# Docker Compose PostgreSQL servisini host makinede bu porta acar.
POSTGRES_PORT=5433

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
# 0, LLM isteği için zaman aşımını devre dışı bırakır.
OLLAMA_LLM_TIMEOUT_MS=0
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
# OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
STORAGE_ROOT=./storage
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=3000
