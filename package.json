{
  "name": "knowledgeos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @knowledgeos/api --filter @knowledgeos/web dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm test:unit && corepack pnpm test:integration && corepack pnpm test:rag",
    "test:unit": "corepack pnpm --filter @knowledgeos/api exec tsx --test test/unit/*.test.ts",
    "test:integration": "corepack pnpm --filter @knowledgeos/api exec tsx --test test/integration/*.test.ts",
    "test:rag": "corepack pnpm --filter @knowledgeos/api exec tsx --test test/rag/*.test.ts",
    "docs:generate": "node apps/api/node_modules/tsx/dist/cli.mjs scripts/generate-chat-workflow-doc.ts",
    "docs:check": "node apps/api/node_modules/tsx/dist/cli.mjs scripts/generate-chat-workflow-doc.ts --check",
    "metadata:audit": "node apps/api/node_modules/tsx/dist/cli.mjs scripts/audit-metadata.ts",
    "indexing:audit": "node apps/api/node_modules/tsx/dist/cli.mjs scripts/audit-indexing-graph.ts",
    "indexing:rebuild": "node apps/api/node_modules/tsx/dist/cli.mjs scripts/rebuild-indexing.ts",
    "verify": "corepack pnpm docs:check && corepack pnpm typecheck && corepack pnpm build && corepack pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
